# =============================================================================
# Supabase — cole aqui os dois valores do projeto
# (Dashboard -> Connect, ou Settings -> API Keys)
# =============================================================================

# URL do projeto, no formato https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Chave curta que começa com sb_publishable_
# (a antiga "anon key", que começa com eyJ, também funciona — o código aceita
#  os dois nomes; veja src/lib/supabase/env.ts)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# -----------------------------------------------------------------------------
# SOMENTE SERVIDOR. Começa com sb_secret_ e IGNORA a RLS: nunca use no browser,
# nunca prefixe com NEXT_PUBLIC_. Deixe vazio — o projeto opera 100% via RLS,
# triggers e RPCs, sem client administrativo.
# -----------------------------------------------------------------------------
SUPABASE_SECRET_KEY=

# -----------------------------------------------------------------------------
# Demonstração (banca). Sem os dois, a tela de login não mostra nada de demo.
# A senha é a mesma das contas do supabase/demo.mjs. Tire depois da apresentação.
# -----------------------------------------------------------------------------
# DEMO_HABILITADO=1
# DEMO_SENHA=